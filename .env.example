# Server-only: where the Commerce Core API lives (never exposed to the browser).
COMMERCE_API_URL=http://localhost:8000
# Same value as COMMERCE_STOREFRONT_API_KEY in the API; lets the API rate-limit per shopper.
STOREFRONT_API_KEY=

# Public settings.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_DEMO_VIDEO_URL=
NEXT_PUBLIC_IMAGE_HOSTS=
